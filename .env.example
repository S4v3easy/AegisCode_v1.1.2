# AegisCode CLI - Environment Variables
# Copy this file to .env and fill in the values

# OpenRouter API Key (for local BYOK mode, fallback if no credentials.json)
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# ─── Cloud Proxy URLs (override only for development) ───
# AEGIS_PROXY_URL=https://www.aegiscode.app/api/scan
# AEGIS_INIT_URL=https://www.aegiscode.app/api/init
# AEGIS_UPDATE_URL=https://www.aegiscode.app/api/update
# AEGIS_REFRESH_URL=https://www.aegiscode.app/api/refresh

# ─── Auth UI URL (override only for development) ───
# AEGIS_UI_URL=https://www.aegiscode.app/cli-auth
